{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@preview/*": [
        "../preview/src/*"
      ]
    },
    "types": [
      "node"
    ]
  }
}
