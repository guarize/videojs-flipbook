---
import type { Title as TitleText } from '../content/copy';
import Kicker from './Kicker.astro';
import Title from './Title.astro';

interface Props {
  id: string;
  kicker: string;
  title: TitleText;
}

const { id, kicker, title } = Astro.props;
---

<header class="sec-head">
  <Kicker label={kicker} />
  <h2 id={id}><Title title={title} /></h2>
</header>
