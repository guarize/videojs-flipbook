---
import { copy } from '../content/copy';
import Demo from './Demo.astro';

const { riffle } = copy;
const { folio, scrub } = riffle;
---

<Demo id="riffle" kicker={riffle.kicker} title={riffle.title}>
  <Fragment slot="copy">
    {riffle.body.map((text) => <p class="body" set:html={text} />)}
    <div class="folio" data-folio>
      <p class="folio-big" aria-hidden="true"><i>p.</i><span data-f-page>{folio.page}</span><span class="of">{folio.of}</span></p>
      <p class="folio-meta"><b>{folio.chapter}</b><br />{folio.note}</p>
    </div>
    <div class="scrub" aria-hidden="true"><span data-f-bar></span></div>
    <p class="scrub-label"><span class="on-scroll">{scrub.scroll}</span><span class="on-touch">{scrub.touch}</span></p>
  </Fragment>
  <div class="scene3d" aria-hidden="true"><div class="anchor" data-book="riffle"></div></div>
</Demo>
